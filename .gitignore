# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
build/

# Environment files (keep templates)
.env
.env.*
!.env.example
!**/.env.example

# Node / React / Vite
node_modules/
frontend/dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Runtime files generated by the backend
backend/app/storage/samples/*
backend/app/storage/reports/*
backend/app/storage/excels/*
backend/app/storage/results/*
!backend/app/storage/**/.gitkeep

# Editors and operating systems
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Temporary files
*.log
*.tmp
*.bak
*.orig
